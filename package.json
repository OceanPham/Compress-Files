{
  "name": "file-compressor",
  "version": "1.0.0",
  "description": "Ứng dụng nén và tối ưu dung lượng Ảnh, Video, PDF và tạo Archive ZIP/7z cục bộ cho Windows x64",
  "main": "./out/main/index.js",
  "author": {
    "name": "Ngọc Huy Dev - Ocean Labs",
    "url": "https://oceanlabs.pro.vn/"
  },
  "homepage": "https://oceanlabs.pro.vn/",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "npm run dist:win",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64",
    "prepare:binaries": "node scripts/prepare-binaries.mjs",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "7zip-bin": "5.2.0",
    "clsx": "2.1.1",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "lucide-react": "0.460.0",
    "pdf-lib": "1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.33.5",
    "tailwind-merge": "2.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "3.0.1",
    "@electron-toolkit/tsconfig": "1.0.1",
    "@electron-toolkit/utils": "3.0.0",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "electron-vite": "2.3.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
